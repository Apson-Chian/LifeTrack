<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>LifeTrack</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>iosamap</string>
    </array>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>LifeTrack uses your location to show your position and record trips you start.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>LifeTrack needs background location access to finish an active trip when the app is not open.</string>
    <key>NSMotionUsageDescription</key>
    <string>LifeTrack uses motion activity to adapt trip recording accuracy and save battery.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>LifeTrack locally analyzes small photo thumbnails and reads time and location metadata to organize categories, travel albums, footprints, and timelines.</string>
    <key>UIBackgroundModes</key>
    <array>
        <string>location</string>
    </array>
    <key>UILaunchScreen</key>
    <dict/>
</dict>
</plist>
